<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Akashic.Tests</RootNamespace>
    <AssemblyName>Akashic.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Akashic.Core\Akashic.Core.csproj" />
    <ProjectReference Include="..\..\src\Akashic.Host\Akashic.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Akashic.Host\preview\hlsl\**\*" Exclude="..\..\src\Akashic.Host\preview\hlsl\**\*.cs"
             Link="preview\hlsl\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Akashic.Host\tools\**\*"
             Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
