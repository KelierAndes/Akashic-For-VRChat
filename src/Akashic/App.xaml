<Application
    x:Class="Akashic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Akashic"
    xmlns:converters="using:Akashic.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <converters:NonZeroCountToVisibilityConverter x:Key="NonZeroCountToVisibilityConverter" />
            <converters:GlyphForKindConverter x:Key="GlyphForKindConverter" />

            <!-- Global color overrides for VRChat branding -->
            <Color x:Key="VRChatAccentColor">#1DB5F0</Color>
            <SolidColorBrush x:Key="VRChatAccentBrush" Color="{StaticResource VRChatAccentColor}" />

            <Thickness x:Key="PagePadding">24,24,24,24</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
