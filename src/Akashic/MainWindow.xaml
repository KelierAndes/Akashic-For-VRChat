<Window
    x:Class="Akashic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Akashic">

    <!-- 主题切换锚定在最外层：NavigationView、Mica 背景板与内容区才会整体跟随 -->
    <Grid x:Name="RootGrid">
            <NavigationView
                x:Name="NavView"
                IsBackButtonVisible="Collapsed"
                PaneDisplayMode="Left"
                IsSettingsVisible="False"
                SelectionChanged="NavView_SelectionChanged"
                ItemInvoked="NavView_ItemInvoked"
                Loaded="NavView_Loaded"
                OpenPaneLength="260">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Margin="8,8,0,0" Spacing="12">
                    <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="{StaticResource VRChatAccentBrush}" />
                    <TextBlock Text="Akashic"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="项目" Tag="projects" Icon="Library">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ProjectCountBadge" Value="0" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="资源" Tag="resources">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="包浏览器" Tag="packages" Icon="Shop" />
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="工具" />
                <NavigationViewItem Content="导入 .unitypackage" Tag="import">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Booth 已购" Tag="booth">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Asset Store 导入" Tag="assetstore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 切换主题：真正的导航项，SelectsOnInvoked=False，点击在 ItemInvoked 处理 -->
                <NavigationViewItem x:Name="ThemeNavItem" Content="切换主题" Tag="theme" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="ThemeNavIcon" Glyph="&#xE793;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content Frame -->
            <Grid>
                <Frame x:Name="ContentFrame" />

                <!-- Global info bar for notifications -->
                <InfoBar
                    x:Name="GlobalInfoBar"
                    IsOpen="False"
                    Severity="Informational"
                    VerticalAlignment="Bottom"
                    Margin="16" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
