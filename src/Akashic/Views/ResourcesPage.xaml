<Page
    x:Class="Akashic.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Akashic.ViewModels"
    Loaded="Page_Loaded">

    <Page.Resources>
        <SolidColorBrush x:Key="AlcomAmberBrush" Color="#FFF1A8" />
        <SolidColorBrush x:Key="AssetStoreTealBrush" Color="#0E8C7F" />

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC3545" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AmberButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AlcomAmberBrush}" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#F5C518" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TableHeaderBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="TableBodyBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>

        <Style x:Key="ColumnNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="资源" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="VPM 存储库、.unitypackage 用户软件包、Booth 导入与 Asset Store 资源在此分开管理，项目页只负责安装"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Pivot Grid.Row="1"
               x:Name="ResourceTabs"
               SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}">

            <!-- ============ Tab 1: VPM repositories ============ -->
            <PivotItem Header="存储库">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.RepositorySummary, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RepositoryStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.HasRepositoryStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="RefreshRepositories_Click" ToolTipService.ToolTip="重新读取 settings.json 并刷新名称">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Click="ImportFromVcc_Click" ToolTipService.ToolTip="把 VCC 已配置的存储库导入本列表，导入后可用 ↑ / ↓ 排序">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="从 VCC 同步" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddRepository_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xECC8;" FontSize="14" />
                                    <TextBlock Text="添加存储库" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Batch bar -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,8"
                            Visibility="{x:Bind ViewModel.IsRepositorySelectionActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.RepositorySelectionSummary, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Click="RemoveSelectedRepositories_Click"
                                        ToolTipService.ToolTip="仅从配置文件移除源地址，不删除本地缓存">
                                    <TextBlock Text="移除所选存储库" />
                                </Button>
                                <Button Style="{StaticResource AmberButtonStyle}"
                                        Click="ClearRepositorySelection_Click">
                                    <TextBlock Text="清空选择" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table header -->
                    <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyling}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind ViewModel.IsAllRepositoriesSelected, Mode=TwoWay}"
                                      Click="SelectAllRepositories_Click"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="2" Text="URL" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Table body -->
                    <Border Grid.Row="3" Style="{StaticResource TableBodyBorderStyling}">
                        <Grid>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingRepositories, Mode=OneWay}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <TextBlock Text="尚未配置 VPM 存储库 · 点击右上角“添加存储库”"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.RepositoryCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ListView x:Name="RepositoryList"
                                      ItemsSource="{x:Bind ViewModel.Repositories, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RepositoryRow">
                                        <Grid Padding="0,10" Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind OriginDisplay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind Url}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Url}" />

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button Click="MoveRepositoryUp_Click"
                                                        Tag="{x:Bind}"
                                                        Padding="5,2"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="上移一位，优先解析">
                                                    <FontIcon Glyph="&#xE70E;" FontSize="13"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                                <Button Click="MoveRepositoryDown_Click"
                                                        Tag="{x:Bind}"
                                                        Padding="5,2"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="下移一位，降低解析优先级">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="13"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                                <Button Click="RemoveRepository_Click"
                                                        Tag="{x:Bind}"
                                                        Padding="5,2"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="从配置移除该存储库">
                                                    <FontIcon Glyph="&#xECC9;" FontSize="15" Foreground="#DC3545" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ============ Tab 2: local .unitypackage library ============ -->
            <PivotItem Header="用户软件包">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.PackageSummary, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PackageStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.HasPackageStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Width="130"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  ToolTipService.ToolTip="按来源筛选包列表（Booth 导入在独立分栏）"
                                  ItemsSource="{x:Bind ViewModel.PackageFilterOptions}"
                                  SelectedIndex="{x:Bind ViewModel.PackageOriginFilter, Mode=TwoWay}" />

                        <AutoSuggestBox Grid.Column="2"
                                        Width="220"
                                        VerticalAlignment="Center"
                                        PlaceholderText="搜索包列表…"
                                        QueryIcon="Find"
                                        Text="{x:Bind ViewModel.PackageSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="RefreshPackages_Click" ToolTipService.ToolTip="重新扫描库目录与手动添加的文件">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                    <TextBlock Text="添加库目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Batch bar -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,8"
                            Visibility="{x:Bind ViewModel.IsPackageSelectionActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.PackageSelectionSummary, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Click="RemoveSelectedPackages_Click"
                                        ToolTipService.ToolTip="从包列表移除手动添加的文件，不删除磁盘文件">
                                    <TextBlock Text="从包列表移除所选" />
                                </Button>
                                <Button Style="{StaticResource AmberButtonStyle}"
                                        Click="ClearPackageSelection_Click">
                                    <TextBlock Text="清空选择" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table header -->
                    <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyling}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind ViewModel.IsAllPackagesSelected, Mode=TwoWay}"
                                      Click="SelectAllPackages_Click"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="图标" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="2" Text="名称" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="3" Text="文件路径" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="4" Text="来源" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="5" Text="版本" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Table body -->
                    <Border Grid.Row="3" Style="{StaticResource TableBodyBorderStyling}">
                        <Grid>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPackages, Mode=OneWay}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <TextBlock Text="包列表为空 · 在“导入 .unitypackage”页选择文件后加入包列表"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.PackageCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ListView ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UserPackageRow">
                                        <Grid Padding="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <FontIcon Glyph="&#xF158;" FontSize="18"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Meta}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind File.FilePath}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind File.FilePath}" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind SourceDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{x:Bind SourceBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind AddedViaDisplay}" />

                                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind VersionDisplay}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind AddedViaDisplay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="6" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Click="RemovePackage_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="6,2"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="从包列表移除（不删除磁盘文件）">
                                                <FontIcon Glyph="&#xECC9;" FontSize="15" Foreground="#DC3545" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Library folders -->
                    <Expander Grid.Row="4"
                              Header="库目录"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsExpanded="False">
                        <StackPanel Spacing="8" Margin="0,4,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="{x:Bind ViewModel.LibraryFoldersSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="未配置库目录 · 库目录内的 .unitypackage 会自动出现在包列表"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.LibraryFolders.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ListView ItemsSource="{x:Bind ViewModel.LibraryFolders, Mode=OneWay}"
                                      SelectionMode="None"
                                      MaxHeight="180">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                                      Foreground="{StaticResource VRChatAccentBrush}"
                                                      Margin="0,0,10,0" VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind}" />

                                            <Button Grid.Column="2"
                                                    Click="RemoveFolder_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="6,2"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="移除该库目录（不删除磁盘文件）">
                                                <FontIcon Glyph="&#xECC9;" FontSize="15" Foreground="#DC3545" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </Grid>
            </PivotItem>

            <!-- ============ Tab 3: packages attached outside VPM ============ -->
            <PivotItem Header="外部包">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ExternalSummary, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ExternalStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.HasExternalStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Width="130"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  ToolTipService.ToolTip="按来源筛选外部包"
                                  ItemsSource="{x:Bind ViewModel.OriginFilterOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ExternalOriginFilter, Mode=TwoWay}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="RefreshExternals_Click" ToolTipService.ToolTip="重新读取 settings.json 中的外部包列表">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Click="AddLocalPackage_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                    <TextBlock Text="添加本地包目录" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddGitPackage_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xECC8;" FontSize="14" />
                                    <TextBlock Text="添加代码仓库" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Batch bar -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,8"
                            Visibility="{x:Bind ViewModel.IsExternalSelectionActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.ExternalSelectionSummary, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Click="RemoveSelectedExternals_Click"
                                        ToolTipService.ToolTip="只移除列表记录，不会删除磁盘文件或项目引用">
                                    <TextBlock Text="移除所选外部包" />
                                </Button>
                                <Button Style="{StaticResource AmberButtonStyle}"
                                        Click="ClearExternalSelection_Click">
                                    <TextBlock Text="清空选择" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table header -->
                    <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyling}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind ViewModel.IsAllExternalSelected, Mode=TwoWay}"
                                      Click="SelectAllExternals_Click"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="2" Text="位置" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="3" Text="来源" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="4" Text="版本 / 分支" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Table body -->
                    <Border Grid.Row="3" Style="{StaticResource TableBodyBorderStyling}">
                        <Grid>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingExternal, Mode=OneWay}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <TextBlock Text="尚未附加外部包 · 本地包需选中含 package.json 的目录，仓库包支持 GitHub / GitLab / Gitee 地址"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.ExternalCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ListView ItemsSource="{x:Bind ViewModel.ExternalPackages, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExternalPackageRow">
                                        <Grid Padding="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind PackageIdDisplay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind LocationDisplay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind LocationDisplay}" />
                                                <TextBlock Text="{x:Bind Meta}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind SourceDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{x:Bind SourceBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind VersionDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind VersionDisplay}" />

                                            <Button Grid.Column="5" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Click="RemoveExternal_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="6,2"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="从外部包列表移除（不删除磁盘文件）">
                                                <FontIcon Glyph="&#xECC9;" FontSize="15" Foreground="#DC3545" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="4"
                               Text="本地包以 file: 引用写入 manifest.json，移动目录后需在项目里重新安装；仓库包（GitHub / GitLab / Gitee，平台按地址自动识别）会下载 zip 快照并复制到项目的 Packages 目录，因此离线也能解析。"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </PivotItem>

            <!-- ============ Tab 4: Booth imports ============ -->
            <PivotItem Header="Booth 导入">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.BoothPackageSummary, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PackageStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.HasPackageStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="RefreshPackages_Click" ToolTipService.ToolTip="重新扫描本地库">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Click="OpenBoothPage_Click" ToolTipService.ToolTip="跳转到 Booth 页下载并解析新的商品">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="去 Booth 页导入" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Batch bar -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,8"
                            Visibility="{x:Bind ViewModel.IsBoothPackageSelectionActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.BoothPackageSelectionSummary, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Click="RemoveSelectedBoothPackages_Click"
                                        ToolTipService.ToolTip="从包列表移除手动添加的文件，不删除磁盘文件">
                                    <TextBlock Text="从包列表移除所选" />
                                </Button>
                                <Button Style="{StaticResource AmberButtonStyle}"
                                        Click="ClearBoothPackageSelection_Click">
                                    <TextBlock Text="清空选择" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table header -->
                    <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyling}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{x:Bind ViewModel.IsAllBoothPackagesSelected, Mode=TwoWay}"
                                      Click="SelectAllBoothPackages_Click"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="图标" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="2" Text="名称" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="3" Text="文件路径" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="4" Text="版本" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Table body -->
                    <Border Grid.Row="3" Style="{StaticResource TableBodyBorderStyling}">
                        <Grid>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingPackages, Mode=OneWay}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <TextBlock Text="还没有 Booth 导入的软件包 · 在工具的 Booth 页登录并解析已购商品后，它们会出现在这里"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.BoothPackageCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ListView ItemsSource="{x:Bind ViewModel.BoothPackages, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UserPackageRow">
                                        <Grid Padding="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <FontIcon Glyph="&#xF158;" FontSize="18"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Meta}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind File.FilePath}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind File.FilePath}" />

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind VersionDisplay}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="Booth 导入" FontSize="11"
                                                           Foreground="{x:Bind SourceBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="5" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Click="RemoveBoothPackage_Click"
                                                    Tag="{x:Bind}"
                                                    Padding="6,2"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="从包列表移除（不删除磁盘文件）">
                                                <FontIcon Glyph="&#xECC9;" FontSize="15" Foreground="#DC3545" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ============ Tab 5: Asset Store, already-fetched resources ============ -->
            <PivotItem Header="Asset Store">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.StoreAcquiredSummary, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.StoreStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind ViewModel.HasStoreStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="RefreshStoreAcquired_Click" ToolTipService.ToolTip="重新扫描 Unity 缓存目录与下载目录">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OpenAssetStorePage_Click"
                                    ToolTipService.ToolTip="跳转到 Asset Store 导入页登录、下载新资源">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE719;" FontSize="14" />
                                    <TextBlock Text="去 Asset Store 页导入" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Table header -->
                    <Border Grid.Row="1" Style="{StaticResource TableHeaderBorderStyling}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="图标" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="1" Text="资源" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="2" Text="发行商 · 分类" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="3" Text="版本" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="5" Text="本地文件" Style="{StaticResource ColumnNameTextStyle}" />
                            <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Table body -->
                    <Border Grid.Row="2" Style="{StaticResource TableBodyBorderStyling}">
                        <Grid>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingStore, Mode=OneWay}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <TextBlock Text="本机还没有已获取的 Asset Store 资源 · 到工具的 Asset Store 页登录下载，或把 Unity 的缓存目录指到本页"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ViewModel.StoreAcquiredCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                            <ListView ItemsSource="{x:Bind ViewModel.StoreAcquired, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssetStoreRow">
                                        <Grid Padding="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <FontIcon Glyph="&#xF158;" FontSize="18"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              Visibility="{x:Bind HasCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind OriginDisplay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind FolderDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind FolderDisplay}" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind VersionDisplay}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AssetStoreTealBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind RowStatus, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind RowStatus, Mode=OneWay}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Meta, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind LocalPathDisplay, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind LocalPathDisplay, Mode=OneWay}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2"
                                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Button Click="AddStoreAcquiredToLibrary_Click"
                                                        Tag="{x:Bind}"
                                                        Padding="5,2"
                                                        Background="Transparent" BorderThickness="0"
                                                        IsEnabled="{x:Bind CanAddToLibrary, Mode=OneWay}"
                                                        ToolTipService.ToolTip="把本地文件登记到用户软件包（来源记为 Asset Store）">
                                                    <FontIcon Glyph="&#xE710;" FontSize="15"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                                <Button Click="OpenAssetDirectory_Click"
                                                        Tag="{x:Bind}"
                                                        Padding="5,2"
                                                        Background="Transparent" BorderThickness="0"
                                                        IsEnabled="{x:Bind HasLocal, Mode=OneWay}"
                                                        ToolTipService.ToolTip="在资源管理器中打开该文件所在目录">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
