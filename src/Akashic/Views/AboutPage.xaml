<Page
    x:Class="Akashic.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="{StaticResource PagePadding}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="24">
            <!-- App Banner -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                <Grid Width="64" Height="64" CornerRadius="12" Background="{StaticResource VRChatAccentBrush}">
                    <FontIcon Glyph="&#xE74C;" FontSize="32" Foreground="White" />
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Akashic" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="VRChat &amp; Unity Package Management Suite"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="专为 VRChat 创作者打造的现代化包管理桌面端工具。融合 C# 8.0/9.0 后端高效依赖解析引擎与 WinUI 3 Fluent Studio 设计语言，提供轻量、快速、直观的 Unity 与 VPM 包管理体验。"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Style="{StaticResource BodyTextBlockStyle}" />

            <!-- Core Features Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="核心特性" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{StaticResource VRChatAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Unity 项目全生命周期管理" FontWeight="SemiBold" />
                            <TextBlock Text="自动检测 Unity 版本、扫描 UPM manifest 与 vpm-manifest 依赖关系并实时同步。"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource VRChatAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="VPM 官方与社区包仓库解析" FontWeight="SemiBold" />
                            <TextBlock Text="接入 VRChat Curated 与第三方社区源，自动化下载、解压、更新及递归依赖解析。"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B5;" FontSize="16" Foreground="{StaticResource VRChatAccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text=".unitypackage 资产包解包与选择性安装" FontWeight="SemiBold" />
                            <TextBlock Text="高效解压 tar.gz 封包，提取 GUID、pathname 与 .meta 元数据并支持自定义按需注入。"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tech Stack -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="技术栈构建" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="• 前端视图: WinUI 3 (Windows App SDK), Fluent Design System, Mica 材质"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• MVVM 架构: CommunityToolkit.Mvvm, Microsoft.Extensions.DependencyInjection"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="• 后端驱动: .NET 8.0 C#, SharpCompress, System.Text.Json"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
