<Page
    x:Class="Akashic.Views.ImportPackagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Akashic.Core.Models"
    Loaded="Page_Loaded">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="导入 .unitypackage" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="把 .unitypackage 加入包列表，之后在项目的包列表中安装到项目"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Action / Setup Card -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Step 1: Select unitypackage file(s) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="1. 选择 .unitypackage 文件" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="BrowsePackage_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="选择文件…" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.PickedFileName, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="260" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: Add to library -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Bottom">
                    <TextBlock Text="2. 加入包列表" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Button Click="AddToLibrary_Click" Padding="20,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xECC8;" FontSize="14" />
                            <TextBlock Text="加入包列表" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Library management lives on the 资源 page -->
                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="包列表管理" FontWeight="SemiBold" />
                    <Button Click="OpenResources_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                            <TextBlock Text="到资源页管理包列表" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Summary -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.PackageInfo, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Asset preview of the picked file -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="资产预览"
                               FontWeight="SemiBold"
                               Padding="16,12,16,8" />
                </Border>

                <ProgressRing Grid.Row="1"
                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1"
                           Text="选择文件后可在此查看内部资产清单"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.Entries.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UnityPackageEntry">
                            <Grid Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="{x:Bind IsDirectory, Converter={StaticResource GlyphForKindConverter}}"
                                          FontSize="14"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind PathName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Guid}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind SizeDisplay}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Status footer -->
        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
