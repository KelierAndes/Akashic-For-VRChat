<Page
    x:Class="Akashic.Views.ProjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Akashic.Core.Models"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- ALCOM green upgrade accent colors -->
        <Color x:Key="AlcomGreenColor">#28A745</Color>
        <SolidColorBrush x:Key="AlcomGreenBrush" Color="{StaticResource AlcomGreenColor}" />
        <SolidColorBrush x:Key="AlcomGreenLightBrush" Color="#1528A745" />

        <Style x:Key="AlcomGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AlcomGreenBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AlcomDarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ALCOM's yellow "clear selection" action -->
        <Style x:Key="AlcomAmberButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF1A8" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#F5C518" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header -->
            <RowDefinition Height="Auto" /> <!-- Toolbar / Actions -->
            <RowDefinition Height="Auto" /> <!-- Batch Selection Bar -->
            <RowDefinition Height="Auto" /> <!-- Progress Bar -->
            <RowDefinition Height="Auto" /> <!-- Table Header -->
            <RowDefinition Height="*" />    <!-- Table List -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Click="Back_Click" Margin="0,0,16,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <!-- Title & Path -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ProjectNameText" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock x:Name="ProjectPathText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Right Controls: Unity Version & Open Unity -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Unity 版本:" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock x:Name="UnityVersionText" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- 打开 UNITY (ALCOM Dark Button) -->
                <Button Style="{StaticResource AlcomDarkButtonStyle}"
                        Click="LaunchUnity_Click"
                        ToolTipService.ToolTip="启动 Unity 编辑器载入此项目">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" />
                        <TextBlock Text="打开 UNITY" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- 云端管理：只在工程场景里的蓝图 id 与账号内容对得上时出现 -->
                <Button x:Name="CloudManageButton"
                        Style="{StaticResource AlcomDarkButtonStyle}"
                        Visibility="Collapsed"
                        Click="CloudManage_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE753;" FontSize="13" />
                        <TextBlock x:Name="CloudManageText" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <DropDownButton Padding="8,6">
                    <FontIcon Glyph="&#xE712;" FontSize="13" />
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="在文件资源管理器中显示" Click="OpenInExplorer_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED25;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="打开 Packages 文件夹" Click="OpenPackagesFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="打开 Assets 文件夹" Click="OpenAssetsFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B9;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="创建项目备份" Click="BackupProject_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- 2. Toolbar Card (管理软件包, 搜索, 升级所有, 筛选) -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8,8,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Refresh -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="管理软件包" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Click="Refresh_Click" Padding="6,6" ToolTipService.ToolTip="重新载入">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Search Box -->
                <AutoSuggestBox Grid.Column="1"
                                PlaceholderText="搜索..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center" />

                <!-- Right Actions: 升级所有, More, 筛选 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 包列表 (库) 由资源页管理 -->
                    <Button Click="OpenLibraryPage_Click" Padding="12,6"
                            ToolTipService.ToolTip="在资源页的用户软件包标签添加或移除 .unitypackage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                            <TextBlock Text="包列表管理" />
                        </StackPanel>
                    </Button>

                    <!-- 升级所有软件包 (最新) -->
                    <Button Style="{StaticResource AlcomGreenButtonStyle}"
                            Click="UpgradeAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="13" />
                            <TextBlock Text="升级所有软件包 (最新)" />
                        </StackPanel>
                    </Button>

                    <!-- More options -->
                    <Button Padding="8,6">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="重新扫描项目依赖" Click="Refresh_Click" />
                                <MenuFlyoutItem Text="在文件资源管理器中打开" Click="OpenInExplorer_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <!-- 筛选软件包: 组内“或”，组间“且”，可多选 -->
                    <DropDownButton Padding="10,6" ToolTipService.ToolTip="可勾选多个条件组合筛选">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71C;" FontSize="13" />
                            <TextBlock Text="筛选软件包" VerticalAlignment="Center" />
                            <InfoBadge Value="{x:Bind ViewModel.ActiveFilterCount, Mode=OneWay}"
                                       Style="{StaticResource InformationalValueInfoBadgeStyle}"
                                       Visibility="{x:Bind ViewModel.ActiveFilterCount, Mode=OneWay, Converter={StaticResource NonZeroCountToVisibilityConverter}}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="状态" IsEnabled="False" />
                                <ToggleMenuFlyoutItem Text="仅已安装"
                                                      IsChecked="{x:Bind ViewModel.FilterInstalled, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem Text="仅未安装"
                                                      IsChecked="{x:Bind ViewModel.FilterNotInstalled, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem Text="可升级"
                                                      IsChecked="{x:Bind ViewModel.FilterUpgradable, Mode=TwoWay}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="包类型" IsEnabled="False" />
                                <ToggleMenuFlyoutItem Text="VPM 软件包"
                                                      IsChecked="{x:Bind ViewModel.FilterVpm, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem Text="UnityPackage 资产包"
                                                      IsChecked="{x:Bind ViewModel.FilterUnityPackage, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem Text="外部包（GitHub / 本地）"
                                                      IsChecked="{x:Bind ViewModel.FilterExternal, Mode=TwoWay}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="导入来源" IsEnabled="False" />
                                <ToggleMenuFlyoutItem Text="Booth 导入"
                                                      IsChecked="{x:Bind ViewModel.FilterBooth, Mode=TwoWay}" />
                                <ToggleMenuFlyoutItem Text="Asset Store"
                                                      IsChecked="{x:Bind ViewModel.FilterAssetStore, Mode=TwoWay}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="清除全部筛选" Click="ClearFilters_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Batch selection bar (only while rows are ticked) -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                Padding="16,8"
                Visibility="{x:Bind ViewModel.IsSelectionActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="· .unitypackage 将导入其全部资产，已安装且无新版的行自动跳过"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource AlcomGreenButtonStyle}"
                            Click="InstallSelected_Click"
                            ToolTipService.ToolTip="对勾选的行执行安装 / 升级">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="安装所选软件包 (最新)" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource AlcomAmberButtonStyle}"
                            Click="ClearSelection_Click">
                        <TextBlock Text="{x:Bind ViewModel.ClearSelectionLabel, Mode=OneWay}" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Progress Bar & Status -->
        <ProgressBar Grid.Row="3" x:Name="ActionProgressBar"
                     Value="{x:Bind ViewModel.InstallProgress, Mode=OneWay}"
                     IsIndeterminate="False"
                     Visibility="Collapsed"
                     Height="3" />

        <!-- 5. Table Header (ALCOM Style) -->
        <Border Grid.Row="4"
                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />    <!-- Checkbox -->
                    <ColumnDefinition Width="3*" />    <!-- 软件包 -->
                    <ColumnDefinition Width="150" />   <!-- 已安装版本 -->
                    <ColumnDefinition Width="140" />   <!-- 最新版本 -->
                    <ColumnDefinition Width="120" />   <!-- 来源 -->
                    <ColumnDefinition Width="100" />   <!-- 操作 -->
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}"
                          Click="SelectAll_Click"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="软件包" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Text="已安装版本" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="3" Text="最新版本" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="4" Text="来源" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="5" Text="操作" FontWeight="SemiBold" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 6. Flat Table List -->
        <Border Grid.Row="5"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,8,8">
            <Grid>
                <!-- Loading Ring -->
                <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Empty state -->
                <TextBlock Text="未找到匹配的软件包"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.FilteredPackages.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                <!-- Items List -->
                <ListView ItemsSource="{x:Bind ViewModel.FilteredPackages, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UnifiedPackageItem">
                            <Grid Padding="0,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />    <!-- Checkbox -->
                                    <ColumnDefinition Width="3*" />    <!-- 软件包 -->
                                    <ColumnDefinition Width="150" />   <!-- 已安装版本 -->
                                    <ColumnDefinition Width="140" />   <!-- 最新版本 -->
                                    <ColumnDefinition Width="120" />   <!-- 来源 -->
                                    <ColumnDefinition Width="100" />   <!-- 操作 -->
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <!-- 软件包 (Name & Id) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Id}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- 已安装版本 (VPM: ALCOM 版本下拉 / 其它: 版本文本) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <ComboBox ItemsSource="{x:Bind AvailableVersions}"
                                              SelectedItem="{x:Bind SelectedVersion, Mode=TwoWay}"
                                              SelectionChanged="VersionComboBox_SelectionChanged"
                                              Tag="{x:Bind}"
                                              MinWidth="105"
                                              FontSize="12"
                                              Padding="8,4"
                                              VerticalAlignment="Center"
                                              Visibility="{x:Bind ShowVersionSelector}" />
                                    <TextBlock Text="{x:Bind InstalledVersion}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind ShowInstalledVersionText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- 最新版本 (ALCOM Style Green Upgrade Pill) -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <!-- Green upgrade badge if upgradable -->
                                    <Button Click="UpgradePackage_Click" Tag="{x:Bind}"
                                            Background="#E8F8ED"
                                            BorderBrush="{StaticResource AlcomGreenBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,3"
                                            Visibility="{x:Bind CanUpgrade}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="{StaticResource AlcomGreenBrush}" />
                                            <TextBlock Text="{x:Bind LatestVersion}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AlcomGreenBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Regular text if not upgradable -->
                                    <TextBlock Text="{x:Bind LatestVersion}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind CanUpgrade, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- 来源 (Official, Curated, UnityPackage, User)；⚠ 表示来自未加入列表的存储库 -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SourceName}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE946;" FontSize="13"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                              VerticalAlignment="Center"
                                              Visibility="{x:Bind ForeignRepository, Converter={StaticResource BoolToVisibilityConverter}}"
                                              ToolTipService.ToolTip="{x:Bind Description}" />
                                </StackPanel>

                                <!-- 操作 (⊖ Uninstall or ⊕ Install + ...) -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- If installed: Uninstall Red Circle Minus Button ⊖ -->
                                    <Button Click="UninstallPackage_Click" Tag="{x:Bind}"
                                            Padding="4,4" Background="Transparent" BorderThickness="0"
                                            Visibility="{x:Bind IsInstalled}"
                                            ToolTipService.ToolTip="卸载此包">
                                        <FontIcon Glyph="&#xECC9;" FontSize="16" Foreground="#DC3545" />
                                    </Button>

                                    <!-- If not installed: Install Circle Plus Button ⊕ -->
                                    <Button Click="InstallPackage_Click" Tag="{x:Bind}"
                                            Padding="4,4" Background="Transparent" BorderThickness="0"
                                            Visibility="{x:Bind IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="安装此包">
                                        <FontIcon Glyph="&#xECC8;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Button>

                                    <!-- More Options ... -->
                                    <Button Padding="4,4" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="复制包名称" Click="CopyPackageId_Click" Tag="{x:Bind Id}" />
                                                <MenuFlyoutItem Text="在文件资源管理器中显示" Click="OpenInExplorer_Click" />
                                                <MenuFlyoutItem Text="在资源页管理包列表…" Click="OpenLibraryPage_Click" Tag="{x:Bind}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 7. UnityPackage asset selection dialog -->
        <ContentDialog x:Name="UnityPackageImportDialog"
                       Title="选择要导入的资产"
                       PrimaryButtonText="导入到项目"
                       CloseButtonText="取消"
                       DefaultButton="Primary">
            <!-- The default 548px dialog is too narrow for asset paths plus the size column. -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">760</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
            </ContentDialog.Resources>
            <ContentDialog.Content>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ImportDialogSummary"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="全选" Click="DialogSelectAll_Click" Padding="12,4" />
                            <Button Content="取消全选" Click="DialogDeselectAll_Click" Padding="12,4" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            MaxHeight="380"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ListView ItemsSource="{x:Bind ViewModel.ImportEntries, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:UnityPackageEntry">
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                  Click="EntryCheckBox_Click"
                                                  Padding="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />

                                        <FontIcon Grid.Column="1"
                                                  Glyph="{x:Bind IsDirectory, Converter={StaticResource GlyphForKindConverter}}"
                                                  FontSize="14"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind PathName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind SizeDisplay}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </ContentDialog.Content>
        </ContentDialog>
    </Grid>
</Page>
