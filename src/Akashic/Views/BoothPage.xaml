<Page
    x:Class="Akashic.Views.BoothPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Akashic.ViewModels">

    <Page.Resources>
        <Style x:Key="AmberButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF1A8" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="BorderBrush" Value="#F5C518" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TableHeaderBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="TableBodyBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>

        <Style x:Key="ColumnNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Booth 已购商品" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="登录已购的 Booth 账号后读取商品列表，下载的压缩包会解析成 .unitypackage / UPM 包并登记到本地库"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.SessionDisplay, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox Width="120"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="按内容类型筛选：可用软件包会剔除演示动画、图集、漫画等无法入 Unity 的内容"
                          ItemsSource="{x:Bind ViewModel.KindFilterOptions}"
                          SelectedIndex="{x:Bind ViewModel.KindFilter, Mode=TwoWay}" />
                <AutoSuggestBox Width="240"
                                VerticalAlignment="Center"
                                PlaceholderText="粘贴商品链接，如 https://booth.pm/ja/items/123456"
                                QueryIcon="Add"
                                Text="{x:Bind ViewModel.NewItemUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                QuerySubmitted="FreeItem_QuerySubmitted"
                                ToolTipService.ToolTip="读取商品页的可下载文件并加入列表；免费商品无需登录即可下载" />
                <Button Click="AddFreeItem_Click" ToolTipService.ToolTip="读取商品页的可下载文件并加入列表（免费商品入口）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加商品" />
                    </StackPanel>
                </Button>
                <Button Click="ChooseDirectory_Click" ToolTipService.ToolTip="更改压缩包与解压结果的保存位置">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="下载目录" />
                    </StackPanel>
                </Button>
                <Button Click="OpenDirectory_Click" ToolTipService.ToolTip="在资源管理器中打开下载目录">
                    <TextBlock Text="打开目录" />
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="Login_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="登录 / 读取已购列表" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Login panel -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Visibility="{x:Bind ViewModel.IsLoginPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="在这一页完成 Booth 登录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="登录状态保存在本机，读取列表与下载都复用它，不会写进配置文件。登录后点“读取已购列表”。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="PanelClose_Click">
                            <TextBlock Text="关闭" />
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Read_Click">
                            <TextBlock Text="读取已购列表" />
                        </Button>
                    </StackPanel>
                </Grid>

                <WebView2 x:Name="BoothWebView" Grid.Row="1" Height="420" />
            </Grid>
        </Border>

        <!-- Batch bar -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8"
                Visibility="{x:Bind ViewModel.IsBatchActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ViewModel.BatchSummary, Mode=OneWay}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Click="DownloadSelected_Click"
                            IsEnabled="{x:Bind ViewModel.IsAnyActionEnabled, Mode=OneWay}">
                        <TextBlock Text="下载所选" />
                    </Button>
                    <Button Style="{StaticResource AmberButtonStyle}"
                            Click="ParseSelected_Click"
                            IsEnabled="{x:Bind ViewModel.IsAnyActionEnabled, Mode=OneWay}">
                        <TextBlock Text="解析所选并入库" />
                    </Button>
                    <Button Click="ClearSelection_Click">
                        <TextBlock Text="清空选择" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table header -->
        <Border Grid.Row="4" Style="{StaticResource TableHeaderBorderStyling}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{x:Bind ViewModel.IsAllItemsSelected, Mode=TwoWay}"
                          Click="SelectAll_Click"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="封面" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="2" Text="商品" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="3" Text="文件" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="4" Text="店铺" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="6" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Table body -->
        <Border Grid.Row="5" Style="{StaticResource TableBodyBorderStyling}">
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Text="还没有读取过已购列表 · 点右上角“登录 / 读取已购列表”，或粘贴商品链接添加免费商品"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.ItemCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                <ListView x:Name="ItemList"
                          ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoothItemRow">
                            <Grid Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8B6;" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind HasCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <Image Source="{x:Bind CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Title}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Number}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Border CornerRadius="3" Padding="4,0"
                                                Background="#0E8C7F"
                                                Visibility="{x:Bind IsFree, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="免费" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border CornerRadius="3" Padding="4,0"
                                                Background="#B7791F"
                                                Visibility="{x:Bind LooksLikeMedia, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="演示·图集" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind FormDisplay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind FormDisplay}" />
                                    <TextBlock Text="{x:Bind HiddenVersionsDisplay, Mode=OneWay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind HasHiddenVersions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind ShopDisplay}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="11"
                                               Foreground="#DC3545"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Click="DownloadItem_Click"
                                            Tag="{x:Bind}"
                                            Padding="5,2"
                                            Background="Transparent" BorderThickness="0"
                                            IsEnabled="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                                            ToolTipService.ToolTip="下载该商品的压缩包">
                                        <FontIcon Glyph="&#xE896;" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button Click="ParseItem_Click"
                                            Tag="{x:Bind}"
                                            Padding="5,2"
                                            Background="Transparent" BorderThickness="0"
                                            IsEnabled="{x:Bind IsDownloaded, Mode=OneWay}"
                                            ToolTipService.ToolTip="解压并登记到用户软件包 / 外部包">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Active transfer -->
        <StackPanel Grid.Row="6" Spacing="4"
                    Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Bind ViewModel.ActiveDisplay, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                         Maximum="100" Minimum="0" Height="6" />
        </StackPanel>

        <TextBlock Grid.Row="7"
                   Text="压缩包与解压结果都留在下载目录里；.unitypackage 和 UPM 包按文件位置登记，移动或删除该目录后需要重新解析。纯 Assets 目录不会自动写入工程，请在 Unity 里手动导入。"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Page>
