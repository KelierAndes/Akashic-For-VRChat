<Page
    x:Class="Akashic.Views.PackageBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Akashic.Core.Models"
    Loaded="Page_Loaded">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="包浏览器" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="浏览与检索 VPM 注册表中的所有可用包"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="500" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="搜索包名称、描述、关键字..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="1" x:Name="PackageCountText"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Loading -->
        <ProgressRing Grid.Row="2" x:Name="LoadingRing" IsActive="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="48" Height="48" />

        <!-- Package list with master-detail layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" x:Name="DetailColumn" />
            </Grid.ColumnDefinitions>

            <!-- Package List -->
            <ListView ItemsSource="{x:Bind ViewModel.FilteredPackages, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="PackageList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VpmPackage">
                        <Grid Padding="16,12" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="40" Height="40" CornerRadius="8"
                                  Background="{StaticResource VRChatAccentBrush}" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE7B8;" FontSize="18" Foreground="White" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Name}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <Border Grid.Column="2" CornerRadius="4" Padding="8,4"
                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Version}" FontSize="12" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Detail Panel -->
            <Border Grid.Column="1" x:Name="DetailPanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="24"
                    Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="DetailDisplayName" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="DetailName" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="版本信息" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DetailVersion" />
                            <TextBlock x:Name="DetailUnity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="8" x:Name="DetailDependencies">
                            <TextBlock Text="依赖项" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsRepeater x:Name="DepsRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel Spacing="8" x:Name="DetailVersionsList">
                            <TextBlock Text="可用历史版本" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsRepeater x:Name="VersionsRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border CornerRadius="4" Padding="8,4" Margin="0,2"
                                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                            <TextBlock Text="{x:Bind}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
