<Page
    x:Class="Akashic.Views.AssetStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Akashic.ViewModels">

    <Page.Resources>
        <SolidColorBrush x:Key="AssetStoreTealBrush" Color="#0E8C7F" />

        <Style x:Key="TableHeaderBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="TableBodyBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>

        <Style x:Key="ColumnNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Asset Store 导入" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="登录 Unity 账号读取我的资产并下载，下载结果与 Booth 导入一样解析登记到本地库；资源页只展示已获取的资源"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.SessionDisplay, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.FilterNote, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasFilterNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <ComboBox Grid.Column="1"
                      Width="130"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      ToolTipService.ToolTip="按缓存状态或列表来源筛选"
                      ItemsSource="{x:Bind ViewModel.ViewFilterOptions}"
                      SelectedIndex="{x:Bind ViewModel.ViewFilter, Mode=TwoWay}" />

            <AutoSuggestBox Grid.Column="2"
                            Width="190"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            PlaceholderText="搜索资源…"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="RefreshAssetStore_Click" ToolTipService.ToolTip="重新扫描缓存目录与下载目录">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Click="ChooseCacheDirectory_Click" ToolTipService.ToolTip="更改 Unity 存放 .unitypackage 的缓存目录">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="缓存目录" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="UnityLogin_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="登录 / 读取我的资产" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Login panel -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Visibility="{x:Bind ViewModel.IsLoginPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="在这一页完成 Unity 登录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="登录状态只保存在本机的 WebView2 配置里，读取列表与下载都在内存中复用，不会写进配置文件。完成后点“读取我的资产”。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="UnityPanelClose_Click">
                            <TextBlock Text="关闭" />
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="UnityRead_Click">
                            <TextBlock Text="读取我的资产" />
                        </Button>
                    </StackPanel>
                </Grid>

                <WebView2 x:Name="UnityWebView" Grid.Row="1" Height="420" />
            </Grid>
        </Border>

        <!-- Batch bar -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8"
                Visibility="{x:Bind ViewModel.IsBatchActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind ViewModel.BatchSummary, Mode=OneWay}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Click="AddSelectedToLibrary_Click"
                            IsEnabled="{x:Bind ViewModel.IsAnyActionEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="把勾选的 .unitypackage 登记到用户软件包，来源记为 Asset Store">
                        <TextBlock Text="加入包列表" />
                    </Button>
                    <Button Click="DownloadSelectedAsset_Click"
                            IsEnabled="{x:Bind ViewModel.IsAnyActionEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="下载勾选资源的 .unitypackage，并解析登记到本地库">
                        <TextBlock Text="下载并解析" />
                    </Button>
                    <Button Click="ClearAssetSelection_Click">
                        <TextBlock Text="清空选择" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table header -->
        <Border Grid.Row="4" Style="{StaticResource TableHeaderBorderStyling}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{x:Bind ViewModel.IsAllAssetsSelected, Mode=TwoWay}"
                          Click="SelectAllAssets_Click"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="图标" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="2" Text="资源" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="3" Text="发行商 · 分类" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="4" Text="版本" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="6" Text="本地文件" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Table body -->
        <Border Grid.Row="5" Style="{StaticResource TableBodyBorderStyling}">
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Text="还没有可读的资源 · 点右上角“登录 / 读取我的资产”，或把 Unity 的缓存目录指到本页面"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.AssetCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                <ListView ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetStoreRow">
                            <Grid Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" />

                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <FontIcon Glyph="&#xF158;" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind HasCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <Image Source="{x:Bind CoverImage, Mode=OneWay}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind OriginDisplay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind FolderDisplay}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind FolderDisplay}" />

                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind VersionDisplay}"
                                           VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AssetStoreTealBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind RowStatus, Mode=OneWay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind RowStatus, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Meta, Mode=OneWay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind LocalPathDisplay, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind LocalPathDisplay, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Click="DownloadAsset_Click"
                                            Tag="{x:Bind}"
                                            Padding="5,2"
                                            Background="Transparent" BorderThickness="0"
                                            IsEnabled="{x:Bind CanDownload}"
                                            ToolTipService.ToolTip="下载该资源的 .unitypackage">
                                        <FontIcon Glyph="&#xE896;" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button Click="AddAssetToLibrary_Click"
                                            Tag="{x:Bind}"
                                            Padding="5,2"
                                            Background="Transparent" BorderThickness="0"
                                            IsEnabled="{x:Bind CanAddToLibrary, Mode=OneWay}"
                                            ToolTipService.ToolTip="把本地文件登记到用户软件包">
                                        <FontIcon Glyph="&#xE710;" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                    <Button Click="OpenAssetDirectory_Click"
                                            Tag="{x:Bind}"
                                            Padding="5,2"
                                            Background="Transparent" BorderThickness="0"
                                            IsEnabled="{x:Bind HasLocal, Mode=OneWay}"
                                            ToolTipService.ToolTip="在资源管理器中打开该文件所在目录">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Active transfer -->
        <StackPanel Grid.Row="6" Spacing="4"
                    Visibility="{x:Bind ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Bind ViewModel.ActiveDisplay, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}"
                         Maximum="100" Minimum="0" Height="6" />
        </StackPanel>
    </Grid>
</Page>
