<Page
    x:Class="Akashic.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Akashic.Core.Models"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- ALCOM Button Styles -->
        <Style x:Key="AlcomDarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2328" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AlcomBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AlcomGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#28A745" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Unity 项目" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="管理您的 VRChat Unity 项目与包配置" 
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddProjectButton" Click="AddProject_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加项目" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <InfoBar
            Grid.Row="1"
            x:Name="StatusInfoBar"
            IsOpen="False"
            Severity="Informational"
            Margin="0,0,0,12" />

        <!-- Projects List Area -->
        <Grid Grid.Row="2">
            <!-- Empty State -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Spacing="16">
                <FontIcon Glyph="&#xE8F1;" FontSize="64"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="暂无项目"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点击上方'添加项目'按钮选择 Unity 项目文件夹"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Loading Ring -->
            <ProgressRing x:Name="LoadingRing"
                          IsActive="False"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="48" Height="48" />

            <!-- Projects Grid -->
            <ScrollViewer x:Name="ProjectsScroller">
                <ItemsRepeater x:Name="ProjectsRepeater" ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="380" MinItemHeight="200"
                                           MinColumnSpacing="14" MinRowSpacing="14"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:UnityProject">
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="18"
                                  PointerPressed="ProjectCard_PointerPressed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Header badges & modified -->
                                    <RowDefinition Height="Auto" /> <!-- Project Name -->
                                    <RowDefinition Height="Auto" /> <!-- Path -->
                                    <RowDefinition Height="*" />    <!-- Packages Info -->
                                    <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Type Badge + Unity Version + Last Modified -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Badges -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <!-- World / Avatar / Unity Badge -->
                                        <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                CornerRadius="4" Padding="8,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="{x:Bind ProjectTypeGlyph}" FontSize="11" />
                                                <TextBlock Text="{x:Bind ProjectTypeDisplayName}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Unity Version Badge -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind UnityVersion}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Last modified -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind LastModifiedDisplay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Row 1: Project Name -->
                                <TextBlock Grid.Row="1" Text="{x:Bind Name}"
                                           FontSize="17" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                                <!-- Row 2: Path -->
                                <TextBlock Grid.Row="2" Text="{x:Bind Path}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />

                                <!-- Row 3: Package Count Info -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <InfoBadge Value="{x:Bind InstalledPackages.Count}"
                                               Style="{StaticResource InformationalValueInfoBadgeStyle}" />
                                    <TextBlock Text="个已配置软件包"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            CornerRadius="4" Padding="6,2" Visibility="{x:Bind HasVpmManifest}">
                                        <TextBlock Text="VPM" FontSize="11"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Row 4: ALCOM 3-Button Layout: [打开 UNITY] [管理] [备份] [...] -->
                                <Grid Grid.Row="4" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- 1. 打开 UNITY (Black) -->
                                        <Button Style="{StaticResource AlcomDarkButtonStyle}"
                                                Click="LaunchUnity_Click"
                                                DataContext="{x:Bind}"
                                                ToolTipService.ToolTip="启动 Unity 编辑器并载入此项目">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                <TextBlock Text="打开 UNITY" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- 2. 管理 (Blue) -->
                                        <Button Style="{StaticResource AlcomBlueButtonStyle}"
                                                Click="ManageProject_Click"
                                                DataContext="{x:Bind}"
                                                ToolTipService.ToolTip="进入项目平铺式软件包管理">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                                <TextBlock Text="管理" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <!-- 3. 备份 (Green) -->
                                        <Button Style="{StaticResource AlcomGreenButtonStyle}"
                                                Click="BackupProject_Click"
                                                DataContext="{x:Bind}"
                                                ToolTipService.ToolTip="备份项目关键资产与配置">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                <TextBlock Text="备份" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 4. 更多菜单 (···) -->
                                    <Button Grid.Column="1" Padding="8,6" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="在文件资源管理器中显示" Click="OpenExplorer_Click" DataContext="{x:Bind}" />
                                                <MenuFlyoutItem Text="复制项目路径" Click="CopyPath_Click" DataContext="{x:Bind}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="从列表中移除" Click="RemoveProject_Click" DataContext="{x:Bind}" Foreground="#DC3545" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
