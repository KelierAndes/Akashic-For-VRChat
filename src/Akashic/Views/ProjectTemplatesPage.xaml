<Page
    x:Class="Akashic.Views.ProjectTemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Akashic.ViewModels"
    xmlns:models="using:Akashic.Core.Models"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="ColumnNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableHeaderBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="TableBodyBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="项目模板" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="新建项目时的起点：Creator Companion 自带的官方模板会自动列出，也可以把自己调好的工程存成模板（只保留 ProjectSettings 与 Packages 清单，软件包交给 Resolver 重新拉取）"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenTemplatesFolderButton" Click="OpenTemplatesFolder_Click"
                        ToolTipService.ToolTip="打开存放模板快照的文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                        <TextBlock Text="打开模板文件夹" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Column header -->
        <Border Grid.Row="2" Style="{StaticResource TableHeaderBorderStyling}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="模板名称" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="2" Text="Unity 版本" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="3" Text="说明 · 来源工程" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="4" Text="创建时间" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource ColumnNameTextStyle}" />
            </Grid>
        </Border>

        <!-- Rows -->
        <Border Grid.Row="3" Style="{StaticResource TableBodyBorderStyling}">
            <Grid>
                <TextBlock Text="没有可用模板 · 未检测到 Creator Companion 的官方模板，也还没有自建模板 —— 到「项目」页里对某个工程点 ··· → 存为项目模板"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap" MaxWidth="640" TextAlignment="Center"
                           Visibility="{x:Bind ViewModel.TemplateCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                <ListView ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectTemplate">
                            <Grid Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Directory}" />

                                <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock Text="{x:Bind KindLabel}" FontSize="11" />
                                </Border>

                                <TextBlock Grid.Column="2" Text="{x:Bind UnityVersion}" FontSize="12"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind NotesDisplay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind NotesDisplay}" />
                                    <TextBlock Text="{x:Bind SourceDisplay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind SourcePath}" />
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="{x:Bind CreatedAtDisplay}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Padding="8,4" Tag="{x:Bind}" Click="OpenTemplateFolder_Click"
                                            ToolTipService.ToolTip="打开这个模板自己的文件夹">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                    </Button>
                                    <Button Padding="8,4" Tag="{x:Bind}" Click="DeleteTemplate_Click"
                                            Visibility="{x:Bind CanDelete}"
                                            ToolTipService.ToolTip="删除模板与它的快照文件夹">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer note -->
        <TextBlock Grid.Row="4"
                   Text="自建模板的快照存放在 %LOCALAPPDATA%\Akashic\Templates，删除只会动这个目录，不碰任何真实工程；「内置」模板直接读自 Creator Companion 的 VRCTemplates 目录，因此不提供删除。"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Page>
