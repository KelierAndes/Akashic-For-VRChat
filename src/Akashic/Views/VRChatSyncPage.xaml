<Page
    x:Class="Akashic.Views.VRChatSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Akashic.ViewModels">

    <Page.Resources>
        <SolidColorBrush x:Key="VRChatBlueBrush" Color="#2A5CEE" />

        <Style x:Key="TableHeaderBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="TableBodyBorderStyling" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>

        <Style x:Key="ColumnNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="VRChat 数据同步" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="在 WebView2 里登录 VRChat 后，用站点自身的接口读取本账号已上传的虚拟形象与世界，蓝图 ID 就是 Unity SDK 里的 Blueprint ID，可直接改名称与描述"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.AccountDisplay, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,2"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.IsFromCache, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.CacheNote, Mode=OneWay}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <ComboBox Grid.Column="1"
                      Width="130"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      ItemsSource="{x:Bind ViewModel.FilterOptions}"
                      SelectedItem="{x:Bind ViewModel.Filter, Mode=TwoWay}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click" ToolTipService.ToolTip="重新读取我的虚拟形象与世界">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Click="Login_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE77B;" FontSize="14" />
                        <TextBlock Text="登录 / 读取我的内容" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Login panel -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Visibility="{x:Bind ViewModel.IsLoginPanelOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="在这一页完成 VRChat 登录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="登录状态只保存在本机的 WebView2 配置里，读取列表与保存修改都在内存中复用会话，不会写进配置文件。登录完成后会自动读取。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="ClosePanel_Click">
                            <TextBlock Text="关闭" />
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Read_Click">
                            <TextBlock Text="读取我的内容" />
                        </Button>
                    </StackPanel>
                </Grid>

                <WebView2 x:Name="VrcWebView" Grid.Row="1" Height="420" />
            </Grid>
        </Border>

        <!-- Table header -->
        <Border Grid.Row="3" Style="{StaticResource TableHeaderBorderStyling}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="184" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="类型" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="1" Text="封面" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="2" Text="名称" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="3" Text="蓝图 ID" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="4" Text="可见性" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="5" Text="其他" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="6" Text="更新时间" Style="{StaticResource ColumnNameTextStyle}" />
                <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource ColumnNameTextStyle}"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Table body -->
        <Border Grid.Row="4" Style="{StaticResource TableBodyBorderStyling}">
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="40" Height="40"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock Text="还没有读取到内容 · 点右上角“登录 / 读取我的内容”，登录后会自动载入"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.RowCount, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

                <ListView x:Name="ContentList"
                          ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VRChatContentRow">
                            <Grid Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="290" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>

                                <!-- Marks the row a jump from a local project landed on. -->
                                <Border Grid.ColumnSpan="8" CornerRadius="3" IsHitTestVisible="False"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource SystemAccentColorDark1}"
                                        Opacity="0.22"
                                        Visibility="{x:Bind IsHighlighted, Mode=OneWay}" />

                                <Border VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2">
                                    <TextBlock Text="{x:Bind KindDisplay}" FontSize="11"
                                               Foreground="{StaticResource VRChatBlueBrush}" />
                                </Border>

                                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <FontIcon Glyph="&#xE91B;" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind HasCover, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               MaxWidth="360" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Description}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind BlueprintId}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Padding="6,2" Tag="{x:Bind BlueprintId}" Click="CopyBlueprint_Click"
                                            ToolTipService.ToolTip="复制蓝图 ID，Unity SDK 的 Blueprint ID 填这个值">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="{x:Bind StatusDisplay}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold" />

                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ExtraDisplay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind UnityVersionDisplay}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="6" Text="{x:Bind UpdatedDisplay}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Tag="{x:Bind}" Click="Edit_Click"
                                            ToolTipService.ToolTip="修改名称与描述">
                                        <TextBlock Text="编辑" />
                                    </Button>

                                    <Button Tag="{x:Bind}" Click="OpenLocalProject_Click"
                                            Visibility="{x:Bind HasLocalProject}"
                                            ToolTipService.ToolTip="{x:Bind LocalProjectTip}">
                                        <TextBlock Text="本地工程" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer note -->
        <TextBlock Grid.Row="5"
                   Text="世界表单可改名称、描述、封面、内容警告、作者标签、可见性、最大人数、YouTube 预览、允许视频域名、默认内容设置、道具能力与发布状态；形象表单可改名称、描述、封面、内容警告、作者标签、可见性，并支持设为当前/备用形象与生成分身。所有修改只写回 VRChat 服务器，不会下载或改动本地工程。读取云端清单后会扫描已注册工程里的场景蓝图 ID，对得上的行给出“本地工程”按钮，项目页也有反向的“云端管理”跳转。"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>
</Page>
